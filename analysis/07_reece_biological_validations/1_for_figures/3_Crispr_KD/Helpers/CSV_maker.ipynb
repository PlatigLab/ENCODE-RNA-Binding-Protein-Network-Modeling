   "source": [
    "import polars as pl\n",
    "from pathlib import Path\n",
    "\n",
    "folders = [\"FINAL_results\"]\n",
    "\n",
    "combined = pl.concat([\n",
    "    pl.read_csv(csv)\n",
    "    for folder in folders\n",
    "    for csv in Path(folder).glob(\"*.csv\")\n",
    "], how=\"diagonal_relaxed\")\n",
    "\n",
    "combined.write_csv(\"final_combined_results.csv\")\n",
    "print(combined.shape)"
   ]
  },
